rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECOGNITION: Secured by the Shahi Gatekeeper
    match /recognition/{document=**} {
      allow read: if true;
      allow write: if request.resource.data.shahiAuthKey == 'CT_SECRET_GATEWAY_2026';
    }

    // 2. ADMIN AUTH / USERS: Allows login checks & profile reads
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. LEADS PIPELINE & ADMIN CRM: Unchanged as requested (100% active for form submissions)
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // 4. PAYMENTS & TRANSACTIONS: LOCKED 🔒
    // Strangers cannot query or read sensitive Cashfree payment logs
    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // 5. B2B OUTBOUND LEADS: Google Maps Realtime Cloud CRM
    match /b2b_leads/{leadId} {
      allow read, write: if true;
    }

    // 6. ADMIN SESSIONS & AUDIT TRAIL: LOCKED 🔒
    // Prevents strangers from viewing your personal IP address, location, and Windows device info
    match /admin_sessions/{sessionId} {
      allow read: if false;
      allow write: if false;
    }

    // ─── CHITTORTECH CLIENT APP COLLECTIONS ─────────────────────

    // 7. PROJECTS: Client project milestones, hosting, domain, SSL
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // 8. TICKETS: Helpdesk ticket creation & resolution
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // 9. INVOICES: Invoices & billing receipts
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // 10. NOTIFICATIONS: In-app broadcast & project update alerts
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
