{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/inventory-management-software-in-*",
        "destination": "/inventory",
        "type": 301
      },
      {
        "source": "/affiliate-marketing-app-mewari-achaar",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/best-erp-software-advantages-in-india",
        "destination": "/erp",
        "type": 301
      },
      {
        "source": "/pos_bill/lead/inquiry_form_justdial",
        "destination": "/contact-us",
        "type": 301
      },
      {
        "source": "/footwear-store",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/pos",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/garments",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/textile",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/cosmetic-store",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/pet-shop",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/gift-shop",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/home-decor-furniture",
        "destination": "/smart-retail",
        "type": 301
      },
      {
        "source": "/readymade-garment",
        "destination": "/smart-retail",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
